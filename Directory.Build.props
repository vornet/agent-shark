<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(AgentSharkPackaging)' == 'true'">$(MSBuildProjectDirectory)/obj/packaging-$(RuntimeIdentifier).lock.json</NuGetLockFilePath>
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <Version>1.0.0</Version>
    <Authors>AgentShark contributors</Authors>
    <RepositoryUrl>https://github.com/vornet/agent-shark</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
